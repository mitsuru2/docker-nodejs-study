{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/ja/*",
      "rewrite": "/ja/index.html"
    },
    {
      "route": "/en-GB/*",
      "rewrite": "/en-GB/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/ja/index.html",
    "exclude": [
      "/*.bundle.js",
      "/*.css",
      "/*.jpg",
      "/*.png",
      "/*.gif",
      "/*.svg",
      "/*.ico",
      "/*.woff2"
    ]
  }
}
