// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
  // Name of the development container. Same as repository name by convention.
  "name": "docker-nodejs-study",

  // Build configuration for the development container.
  // Using GHCR cache for faster builds. Replace 'ref' with your own GHCR repository if needed.
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "cacheFrom": "type=registry,ref=ghcr.io/mitsuru2/docker-nodejs-study-devcontainer:buildcache"
  },

  // User and workspace configuration.
  // Configure same user and workspace settings as the container.
  "remoteUser": "dev",
  "workspaceFolder": "/app",
  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/app",

  // NET_ADMIN/NET_RAW:
  // They are required by scripts/init-firewall.sh (iptables/ipset) to
  // restrict outbound network access to an allowlist for AI agented sessions.
  // This ensures that the container has the necessary network capabilities for firewall management.
  // --env-file:
  // Specifies the path to the environment file containing secrets for the container.
  // Environment file shall be stored out of source tree to avoid accidental commits of secrets.
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--env-file", "${localEnv:HOME}/.config/devcontainer-secrets/docker-nodejs-study.env"
    // Required environment variables:
    // - GITHUB_TOKEN: Required for GitHub authentication within the container.
    // - PRIMENG_LICENSE_KEY: Required for PrimeNG components license.
    // 
    // How to update:
    // 1. Update the environment file at the specified path with the required secrets.
    // 2. Rebuild the dev container to apply the updated environment variables.
  ],

  // Features to add to the dev container. More info: https://containers.dev/features.
  // - GitHub Copilot CLI: Copilot Agent for local development within the container.
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli:1": { "version": "1.0.105" }
  },

  // Container environment variables.
  "containerEnv": {
    // Override Git credential helper settings for the container.
    // This ensures that Git uses `GH_TOKEN` written in the --env-file.
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "credential.helper",
    "GIT_CONFIG_VALUE_1": "!gh auth git-credential"
  },

  // Remote environment variables for the VS Code server running inside the container.
  "remoteEnv": {
    // Disable SSH agent forwarding inside the container.
    "SSH_AUTH_SOCK": "",
    // Disable Git credential helper inside the container.
    "GIT_ASKPASS": "",
    "VSCODE_GIT_IPC_HANDLE": "",
    "VSCODE_GIT_ASKPASS_MAIN": "",
    "VSCODE_GIT_ASKPASS_NODE": "",
    "VSCODE_GIT_ASKPASS_EXTRA_ARGS": ""
  },

  // Command to run after the container starts. 
  // Initializes the firewall and installs dependencies.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && npm ci",
  
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot-chat",
        "Angular.ng-template",
        "esbenp.prettier-vscode"
      ]
    },
    "settings": {
      // Disable terminal-based Git authentication inside the container.
      // Force Git to use the configured credential helper instead of prompting for credentials in the terminal.
      "git.terminalAuthentication": false,

      // Enable format on save for all supported file types.
      "editor.formatOnSave": true
    }
  },

  // Additional volumes to persist configuration and credentials across container restarts.
  "mounts": [
    // Persist Copilot CLI configuration across container lifecycles.
    "type=volume,source=${devcontainerId}-copilot-cli-config,target=/home/dev/.copilot"
  ]
}
