// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
  "name": "docker-nodejs-study",
  "build": {
    // Sets the run context to one level up instead of the .devcontainer folder.
    "context": "..",
    // Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
    "dockerfile": "../Dockerfile"
  },

  // NET_ADMIN/NET_RAW are required by scripts/init-firewall.sh (iptables/ipset) to
  // restrict outbound network access to an allowlist for Claude Code sessions.
  // --env-file injects .devcontainer/secrets.env as real container environment
  // variables (available to every process, including VS Code extensions such as
  // Claude Code) rather than only the integrated terminal. Editing secrets.env
  // requires a container rebuild (not just reopening a terminal) to take effect.
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--env-file",
    ".devcontainer/secrets.env"
  ],

  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Uncomment the next line to run commands after the container is created.
  // "postCreateCommand": "cat /etc/os-release",

  // Configure tool-specific properties.
  // "customizations": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-cosmosdb",
        "anthropic.claude-code"
      ]
    },
    "settings": {
      "editor.formatOnSave": true
    }
  },

  // Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "node",

  // Ensure the 'node' user has ownership of the mounted volume before installing packages.
  // Install TLS/SSL certificate for CosmosDB.
  "postCreateCommand": "bash .devcontainer/post.sh",

  // Add the Azure volumes to the container to keep credentials persistent.
  "mounts": ["source=claude,target=/home/node/.claude,type=volume"]
}
