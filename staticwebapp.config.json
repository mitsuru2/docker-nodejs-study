{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/",
      "rewrite": "/ja/index.html"
    },
    {
      "route": "/",
      "redirect": "/ja/",
      "statusCode": 302,
      "matchCondition": {
        "header": [
          {
            "name": "Accept-Language",
            "value": "ja.*"
          }
        ]
      }
    },
    {
      "route": "/",
      "redirect": "/en-GB/",
      "statusCode": 302,
      "matchCondition": {
        "header": [
          {
            "name": "Accept-Language",
            "value": "en.*"
          }
        ]
      }
    },
    {
      "route": "/ja/*",
      "rewrite": "/ja/index.html",
      "matchCondition": {
        "fileExtensions": ["bundle.js", "css", "jpg", "png", "gif", "svg", "ico", "woff2"],
        "negateFileExtensions": true
      }
    },
    {
      "route": "/en-GB/*",
      "rewrite": "/en-GB/index.html",
      "matchCondition": {
        "fileExtensions": ["bundle.js", "css", "jpg", "png", "gif", "svg", "ico", "woff2"],
        "negateFileExtensions": true
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/ja/index.html"
  }
}
