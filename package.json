{
  "name": "docker-nodejs-study",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-en": "ng serve --configuration=en-GB",
    "build": "node ./script/generate-build-metadata.mjs && node ./script/generate-license.mjs && rm -rf dist && ng build --localize",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "new-page": "./script/new-page.sh",
    "new-ui": "./script/new-ui.sh",
    "new-feature": "./script/new-feature.sh",
    "new-utility": "./script/new-utility.sh",
    "new-service": "./script/new-service.sh",
    "new-pipe": "./script/new-pipe.sh",
    "server": "node dist/docker-nodejs-study/server/server.mjs",
    "catalog": "ng run docker-nodejs-study:serve:ui-catalog",
    "lint": "ng lint",
    "i18n": "ng extract-i18n --output-path src/locale",
    "seed": "node ./.devcontainer/seed-cosmos.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-server": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@angular/ssr": "^22.0.6",
    "@azure/cosmos": "^4.9.2",
    "@azure/identity": "^4.13.1",
    "express": "^5.1.0",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/localize": "^22.0.6",
    "@eslint/js": "^10.0.1",
    "@primeuix/themes": "^3.0.0-rc.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "primeng": "^22.0.0-rc.1",
    "start-server-and-test": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "lavamoat": {
    "allowScripts": {
      "@angular/build>esbuild#0.28.1": false,
      "@angular/build>lmdb#3.5.4": false,
      "@angular/build>lmdb>msgpackr>msgpackr-extract#3.0.4": false,
      "@angular/build>sass>@parcel/watcher#2.5.6": false,
      "vitest>vite>esbuild#0.27.3": false
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true,
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
