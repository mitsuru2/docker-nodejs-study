{
  "name": "docker-nodejs-study",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-en": "ng serve --configuration=en-GB",
    "build": "rm -rf dist && ng build --localize",
    "build2": "start-server-and-test start-server http://localhost:4000 'rm -rf dist && ng build --localize'",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "new-page": "./script/new-page.sh",
    "new-ui": "./script/new-ui.sh",
    "new-feature": "./script/new-feature.sh",
    "new-utility": "./script/new-utility.sh",
    "new-service": "./script/new-service.sh",
    "new-pipe": "./script/new-pipe.sh",
    "server": "node dist/docker-nodejs-study/server/server.mjs",
    "catalog": "ng run docker-nodejs-study:serve:ui-catalog",
    "lint": "ng lint",
    "i18n": "ng extract-i18n --output-path src/locale",
    "seed": "node ./.devcontainer/seed-cosmos.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/ssr": "^21.2.3",
    "@azure/cosmos": "^4.9.2",
    "@primeuix/themes": "^2.0.3",
    "express": "^5.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/localize": "^21.2.5",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "picomatch": "4.0.4"
  }
}
